# DocBook Environment Variables Example
PROJECT_NAME="DocBook API"
VERSION="1.0.0"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./docbook.db"
# Or PostgreSQL for Render / Production / Local:
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# JWT Secret & Expiry
SECRET_KEY="replace-with-a-random-secure-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Brevo Email API (https://brevo.com)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@docbook.app"
BREVO_SENDER_NAME="DocBook Healthcare"

# Telegram Bot Notification (@BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Initial Admin Seed Credentials
INITIAL_ADMIN_NAME="System Admin"
INITIAL_ADMIN_EMAIL="admin@docbook.com"
INITIAL_ADMIN_PASSWORD="Admin@123"
